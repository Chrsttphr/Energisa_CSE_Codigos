Option Explicit

Public Sub DA_Atualizar_Tabela_Dinamica( _
    Optional ByVal NomeAbaResumo As String = "Resumo", _
    Optional ByVal NomeAbaDados As String = "Base_Conciliacao", _
    Optional ByVal PrimeiraCelula As String = "A1")

    Dim st As AppState
    Dim wsResumo As Worksheet, wsDados As Worksheet
    Dim pt As PivotTable
    Dim src As String
    Dim rngFonte As Range
    Dim pc As PivotCache
    Dim updated As Long

    On Error GoTo SAIDA
    BeginFastMode st

    ' ---- Planilhas ----
    Set wsResumo = GetWorksheetByNameCI(ThisWorkbook, NomeAbaResumo)
    If wsResumo Is Nothing Then Err.Raise 5, , "Aba '" & NomeAbaResumo & "' não encontrada."

    Set wsDados = GetWorksheetByNameCI(ThisWorkbook, NomeAbaDados)
    If wsDados Is Nothing Then Err.Raise 5, , "Aba '" & NomeAbaDados & "' não encontrada."

    ' ---- Fonte dinâmica ----
    Set rngFonte = FonteDinamica(wsDados, PrimeiraCelula)
    If rngFonte Is Nothing Then Err.Raise 5, , "Fonte de dados inválida."
    If WorksheetFunction.CountA(rngFonte) = 0 Then Err.Raise 5, , "Fonte de dados vazia."

    src = "'" & wsDados.Name & "'!" & rngFonte.Address(True, True, xlA1, True)

    If wsResumo.PivotTables.Count = 0 Then GoTo SAIDA

    ' ---- PivotCache único ----
    Set pc = ThisWorkbook.PivotCaches.Create(xlDatabase, src)

    For Each pt In wsResumo.PivotTables
        pt.ChangePivotCache pc
        pt.PivotCache.Refresh
        pt.RefreshTable
        updated = updated + 1
    Next pt

    Debug.Print "Pivôs atualizados em '" & wsResumo.Name & "': " & updated

SAIDA:
    EndFastMode st
End Sub

